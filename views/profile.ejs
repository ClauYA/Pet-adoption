<!doctype html>
<html>
<head>
    <title>Pets</title>
    <link rel="stylesheet" href="//netdna.bootstrapcdn.com/bootstrap/3.0.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="//netdna.bootstrapcdn.com/font-awesome/4.0.3/css/font-awesome.min.css">
    <link rel="stylesheet" href="/css/profile.css">
</head>
<body>
  <header>
     <nav class="nav-bar">
      <div class="logo-title">
        <img src="../img/logo.png" alt="logo find a friend">
        <h3 class="title">Find your friend</h3>
      </div>
      <div>
       <a href="/logout" class="btn btn-nav btn-xl">Logout</a> </div>
      </nav>
  </header>
  
  <section class="container"> 
    <section class="row">
      <!-- LOCAL INFORMATION -->
      <section class="col-sm-6">
        <section class="well">
          <h3><span class="fa fa-user"></span> Welcome!</h3>
          <h2>
          <strong><%= data.name %></strong>
          </h2>
          <div>
            <a href="/unlink/local" class="btn btn-default">Unlink</a>
            <a href="/connect/local" class="btn btn-default">Connect Local</a>
          <div>
        </section>
      </section>
     <section class="col-sm-6">
          <h2>Add new pet</h2>
          <form action="/pets" method="POST" class="formulario">
            <input type="text" placeholder="Rocky" name="name" class="input-pet">
            <select name="type" id="pet-type" class="input-pet">
              <option value="">Choose a type</option>
              <option value="Dog">Dog</option>
              <option value="Cat">Cat</option>
              <option value="Hamster">Hamster</option>
              <option value="Parrot">Parrot</option>
              <option value="Spider">Spider</option>
              <option value="Goldfish">Goldfish</option>
            </select>
            <input type="text" placeholder="Chihuahua" class="input-pet" name="breed">
            <input type="number" placeholder="2" name="age" class="input-pet">
            <select name="sex" id="pet-sex" class="input-pet">
              <option value="">Choose sex</option>
              <option value="Female">Female</option>
              <option value="Male">Male</option>
            </select>
            <button type="submit" class="btn btn-primary btn-m">Submit</button>
            <p id="message"></p>
            </form>
        </section> 
    </section>
  
    <section class="profile-header text-left">
      <section>
        <h1>Manage pets</h1>
        <p>Keep every profile ready for a thoughtful introduction</p>
      </section>
    </section>
  <section class="table-wrapper">
  <table>
    <tr class="table-headings">
      <th>Name</th>
      <th>Type</th>
      <th>Breed</th>
      <th>Age</th>
      <th>Sex</th>
      <th>Description</th>
      <th>Adopt</th>
      <th>Actions</th>
    </tr>
    <% if (mascotas.length === 0) { %>
      <tr class="table-body">
        <td colspan="8">There is no pets for adoption right now =(</td>
      </tr>
    <% } else { %>
      <% mascotas.forEach(pet => { %>
        <tr class="table-body">
          <td><%= pet.name %></td>
          <td><%= pet.type %></td>
          <td><%= pet.breed %></td>
          <td><%= pet.age %></td>
          <td><%= pet.sex %></td>
          <td><%= pet.description %></td>
          <td><span class="chip"><%= pet.adopt %></span></td>
          <td>
            <button type="button" class="btn btn-warning btn-m btn-edit" data-id="<%= pet._id %>"><span class="fa fa-pencil"></span> Edit</button>
            <button type="button" class="btn btn-danger btn-m btn-delete" data-id="<%= pet._id %>"><span class="fa fa-trash-o"></span> Delete</button>
          </td>
        </tr>
      <% }) %>
    <% } %>
  </table>
</section>
   <dialog id="dialog-edit-pet">
      <h2>Update pet</h2>
          <form method="dialog" id="form-dialog-edit-pet">
            <input type="hidden" name="itemId" class="input-pet">
            <input type="text" placeholder="Rocky" name="name" class="input-pet"><br>
            <label for="pet-select" class="input-pet">Choose the type:</label>
            <select name="type" id="pet-type" class="input-pet">
                <option value="">Please choose an option</option>
                <option value="Dog">Dog</option>
                <option value="Cat">Cat</option>
                <option value="Hamster">Hamster</option>
                <option value="Parrot">Parrot</option>
                <option value="Spider">Spider</option>
                <option value="Goldfish">Goldfish</option>
            </select>
            <input type="text" placeholder="Chihuahua" name="breed" class="input-pet">
            <input type="number" placeholder="2" name="age" class="input-pet">
            <label for="pet-select" class="input-pet">Choose the sex:</label>
            <select name="sex" id="pet-sex" class="input-pet">
                <option value="">--Please choose an option--</option>
                <option value="Female">Female</option>
                <option value="Male">Male</option>
            </select>
              <button type="submit" class="btn btn-success btn-m">Save</button>
              <button type="button" class="btn btn-danger btn-m" id="edit-cancel">Cancel</button>
            
          </form>
  </dialog>
  </section>
  
<script src="/js/profile.js"></script>

</body>
</html>
